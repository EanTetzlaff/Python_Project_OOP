import streamlit as st

st.title("Let's input your personalized vehicle!")

choice = st.selectbox(
    "Select your vehicle type:",
    ["SUV", "Sedan", "Minivan", "Truck"]
)

with st.form("Vehicle Info"):
    brand = st.text_input("Enter the desired brand: ")
    model = st.text_input("Enter the desired model: ")
    year = st.text_input("Enter the desired year: ")
    color = st.text_input("Enter the desired color: ")
    mileage = st.text_input("Enter the desired mileage: ")

    submitted = st.form_submit_button("Continue to your personalized results!")

if submitted:
    st.session_state["vehicle_data_host"] = {
        "type": choice,
        "brand": brand,
        "model": model,
        "year": year,
        "color": color,
        "mileage": mileage
    }

    st.switch_page("pages/results_screen.py")            #fix to switch to next host page
