import streamlit as st

st.title("Let's input your vehicle!")

choice = st.selectbox(
    "Select your vehicle type:",
    ["SUV", "Sedan", "Minivan", "Truck"]
)

with st.form("Vehicle Info"):
    brand = st.text_input("Enter your vehicle's brand: ")
    model = st.text_input("Enter vehicle's model: ")
    year = st.text_input("Enter your vehicle's year: ")
    color = st.text_input("Enter your vehicle's color: ")
    mileage = st.text_input("Enter your vehicle's mileage: ")

    submitted = st.form_submit_button("Continue to your personalized results!")

if submitted:
    st.session_state["vehicle_data_host"] = {
        "type": choice,
        "brand": brand,
        "model": model,
        "year": year,
        "color": color,
        "mileage": mileage
    }

    st.switch_page("pages/Host_confirmation_screen.py")
