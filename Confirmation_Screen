import streamlit as st

st.title("Finalize your purchase!")

with st.form("Payment Information"):
    st.info("Payment Information")
    if st.form_submit_button("Pay with credit card"):
        card_number = st.text_input("Enter your Credit Card Number", type="password")
        name = st.text_input("Enter the name on your card")
        exp_date = st.text_input("Enter your expiration date")
        cvc = st.text_input("Enter your CVC")
        st.form_submit_button("Pay Now")



