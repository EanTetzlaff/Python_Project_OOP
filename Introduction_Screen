col4.page_link("pages/Sign_Up_Screen.py", label="Sign up")
if "current_page" not in st.session_state:
    st.session_state["current_page"] = st.session_state.current_page = "Intro_Website_GUI.py"
if col1.button("Renter signin"):
    with st.form("Sign up"):
        st.text_input("Enter your Email Address")
