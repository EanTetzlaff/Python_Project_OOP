import streamlit as st

st.markdown(
"""
    <style>
        [data-testid="stSidebarNav"] [display: none !important;}
        [data-testid="stSidebar"] {display: none !important;}
    </style>
    """,
    unsafe_allow_html=True,
)

st.title("Welcome to Choice Rentals")
st.markdown("**Sign in or Create Account!**") #one star to italicize, two to bold


if "active_tab" not in st.session_state:
    st.session_state["active_tab"] = st.session_state["active_tab"] = "renter"

col1,col2,col3,col4 = st.columns(4)

if col1.button("Renter signin"):
    st.session_state["active_tab"] = "renter"
if col2.button("Host signin"):
    st.session_state["active_tab"] = "host"
if col3.button("Admin signin"):
    st.session_state["active_tab"] = "admin"
if col4.button("Sign up"):
    st.session_state["active_tab"] = "signup"

if st.session_state["active_tab"] == "renter":
    with st.form("renter_form"):
        email = st.text_input("Enter your Email Address")
        password = st.text_input("Enter your Password", type="password")
        submitted = st.form_submit_button("Sign in")

        if submitted:
            if email and password:
                st.session_state["email"] = email
                st.switch_page("pages/user_choice_screen.py")
            else:
                st.error("Please check your email and password")

