class SUV:
    def __init__(self, brand, model, year, color, milage):
        self.brand = brand
        self.model = model
        self.year = year
        self.color = color
        self.milage = milage

    def display(self):
        print(f"brand: {self.brand}, model: {self.model}, year: {self.year}, color: {self.color}, milage: {self.milage}")

